# Copie este arquivo para ".env.local" e preencha com os valores reais

# --- Supabase (públicas por design) ---
# Painel do Supabase -> Project Settings -> API
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=sua-chave-publica-anon-aqui

# --- Google Gemini (grátis, sem cartão de crédito) ---
# Use para sugestão de passagem bíblica e moderação do mural.
# Crie sua chave em: https://aistudio.google.com/apikey
VITE_GEMINI_API_KEY=sua-chave-gemini-aqui

# NOTA: As chaves acima ficam no navegador do usuário (é normal e seguro).
# A chave "service_role" do Supabase NUNCA deve entrar aqui — ela fica
# apenas nas Secrets das Edge Functions, no painel do Supabase.
